# Postgres (Cloud SQL). Required.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Session signing (required in production). Also derives token encryption if TOKEN_ENCRYPTION_KEY unset.
AUTH_SECRET=saathi-dev-secret-change-me
# TOKEN_ENCRYPTION_KEY=

PORT=4747
# Public site URL (Cloud Run production URL, or http://127.0.0.1:4747 locally)
APP_BASE_URL=http://127.0.0.1:4747

# --- Google Cloud / Vertex (ADC only — no API keys) ---
GOOGLE_CLOUD_PROJECT=saathi-510820
GCP_REGION=us-central1
# SAATHI_MODEL=gemini-2.5-flash
# Local live agents: gcloud auth application-default login

# --- Instagram / Meta (Instagram Login) ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# META_REDIRECT_URI=https://saathi-160174088264.us-central1.run.app/api/auth/instagram/callback
# META_GRAPH_VERSION=v22.0

# Stub Google OAuth (UI only until real credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
