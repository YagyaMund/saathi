# Postgres (Cloud SQL / Neon / local). SQLite file: URLs are no longer supported.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- LLM (platform keys — not per-seller) ---
# Current: OpenAI. Set this for live agent replies.
OPENAI_API_KEY=
# Optional model override (default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Later: Gemini / Vertex on saathi-510820 (used only when OPENAI_API_KEY is unset)
GEMINI_API_KEY=
# SAATHI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=saathi-510820

# Session signing secret (required in production)
AUTH_SECRET=saathi-dev-secret-change-me

PORT=4747

# Stub Google OAuth (UI only until real credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
