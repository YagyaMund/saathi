# Postgres (Cloud SQL / Neon / local).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Session signing (required in production). Also used to derive token encryption if TOKEN_ENCRYPTION_KEY unset.
AUTH_SECRET=saathi-dev-secret-change-me
# Optional dedicated key for encrypting Instagram tokens at rest
# TOKEN_ENCRYPTION_KEY=

PORT=4747
# Public site URL (OAuth redirect + docs). On Vercel, APP_BASE_URL=https://saathi-ruby.vercel.app
APP_BASE_URL=http://127.0.0.1:4747

# --- Instagram / Meta (Instagram Login — preferred) ---
# Instagram App ID + App Secret from Meta App Dashboard → Instagram → API setup with Instagram login
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Must match an OAuth redirect URI in the Meta dashboard
# META_REDIRECT_URI=https://saathi-ruby.vercel.app/api/auth/instagram/callback
# META_GRAPH_VERSION=v22.0

# --- LLM / Google Cloud ---
# Cloud Run production: Vertex Gemini via Application Default Credentials (no API key).
GOOGLE_CLOUD_PROJECT=saathi-510820
GCP_REGION=us-central1
# SAATHI_MODEL=gemini-2.0-flash-001
# VERTEX_MODEL=gemini-2.0-flash-001

# Local / Vercel fallback: Gemini API key (AI Studio) — not used on Cloud Run when ADC works
# GEMINI_API_KEY=

# Interim demo key (OpenAI-compatible HTTP; UI shows "LLM") — Vercel/local only
# LLM_API_KEY=
# OPENAI_API_KEY=   # deprecated alias for LLM_API_KEY


# Stub Google OAuth (UI only until real credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
